# Copie para ".env" e preencha

# --- IA generativa (Google AI Studio) ---
GEMINI_API_KEY=coloque_sua_chave_aqui
GEMINI_MODELO=gemini-2.5-flash

# --- Arduino --- (vazio = detecção automática)
# Windows: COM3 | Linux: /dev/ttyUSB0 | macOS: /dev/cu.usbmodem101
ARDUINO_PORTA=

# --- Classificação ---
# Lâmina d'água (cm) a partir da qual o ponto é "poça" e "alagado"
LAMINA_POCA_CM=1.0
LAMINA_ALAGADO_CM=3.0
# Modo atenção: liga quando a água sobe mais rápido que isso (cm/min)
# e desliga quando a subida fica abaixo do segundo valor
TENDENCIA_ATENCAO_LIGA=1.0
TENDENCIA_ATENCAO_DESLIGA=0.3

# --- Ponto monitorado (sem GPS: coordenada fixa) ---
NOME_ESTACAO=Aurora - Ciclovia (ponto de teste)
LATITUDE=-23.5740
LONGITUDE=-46.6230

# --- Integração com o MVP (opcional; vazio desliga) ---
MVP_API_URL=
MVP_TOKEN=
